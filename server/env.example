# ============================================
# EDRSR-AI server environment (the one env reference)
# ============================================
# Copy to server/.env for local runs (dotenv reads ./.env from the process working
# directory, so start the server from server/). On a VPS use a systemd EnvironmentFile
# with plain KEY=VALUE lines instead (see docs/DEPLOYMENT.md).
#
# Values below are the recommended VPS values. Where a variable is unset, the code
# uses its own default, which can differ (e.g. QUEUE_PUMP_INTERVAL_MS 60000,
# JOBS_MAX_LIMIT 100, REQUEST_DELAY_MS 150). Required variables are marked REQUIRED.

# === Gemini (REQUIRED: at least one valid key; keys start with "AIza") ===
# One key, or several (comma/space/newline separated) to raise rate limits. GEMINI_API_KEYS wins.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Primary model, plus a fallback tried on the same key on 429/503 (quota is per model, so it adds capacity).
# Production uses the newest stable Flash with a full-size fallback; see docs/DEPLOYMENT.md for the 2026-10 availability
# check (3.8 and 3.5 are often "503 high demand" on the free tier, 3.6 and 3-flash-preview were reliable).
# FALLBACK_MODEL_NAME may be a comma-separated list tried in order on the same key ("gemini-3.6-flash,gemini-2.5-flash").
# An empty FALLBACK_MODEL_NAME disables the fallback.
MODEL_NAME=gemini-3.8-flash
FALLBACK_MODEL_NAME=gemini-3.6-flash,gemini-2.5-flash

# Google recommends 1.0 for all Gemini 3 models (lower values can loop). Use ~0.3 only with Gemini 2.5.
TEMPERATURE=1.0
TOP_K=40
TOP_P=0.8
MAX_TOKENS=65536
MAX_TOKENS_PER_BATCH=60000

# Rate-limit backoff (ms) and soft-ban of a key after repeated 429s
GEMINI_RATE_LIMIT_COOLDOWN_MS_DEFAULT=60000
GEMINI_RATE_LIMIT_COOLDOWN_MS_FLASH=60000
GEMINI_RATE_LIMIT_COOLDOWN_MS_PRO=90000
GEMINI_RATE_LIMIT_SOFTBAN_MS=180000
GEMINI_RATE_LIMIT_SOFTBAN_THRESHOLD=3

# Retry budget per batch and recursion depth when a batch is split after a failure
MAX_RETRIES=3
BATCH_FALLBACK_MAX_DEPTH=2

# === CLI proxy (optional, off by default) ===
# OpenAI-compatible proxy tried before the official keys; official keys stay the fallback.
# When enabled, the server pings CLI_PROXY_URL every 14 minutes (Render-style keep-alive).
ENABLE_CLI_PROXY=false
CLI_PROXY_URL=
CLI_PROXY_MODEL=gemini-3.1-pro-high
CLI_PROXY_API_KEY=
CLI_PROXY_API_KEYS=
CLI_PROXY_MAX_ATTEMPTS_PER_KEY=1

# === Server ===
# This file is the local-development template. On any public host set NODE_ENV=production
# (or staging): it enables the origin allow-list and HSTS and disables the dev-token bypass.
# Unset behaves like development. Production values: docs/DEPLOYMENT.md.
NODE_ENV=development
PORT=4000
# Use 127.0.0.1 when nginx runs on the same host.
HOST=0.0.0.0
LOG_LEVEL=info
# Heap size in MB, read only by server/start-with-gc.js (npm run start:gc). With systemd pass
# --max-old-space-size to node directly and set UV_THREADPOOL_SIZE=8 in the unit, not here.
MAX_OLD_SPACE_MB=1200
# Reported by /api/health/light; defaults to the root package.json version.
APP_VERSION=

# Reverse proxy: number of trusted proxy hops (set 1 behind nginx, 2 behind Cloudflare + nginx),
# or a CIDR list. Without it every client shares the proxy's IP in rate limits and logs.
# Leave empty when nothing sits in front of the server (local dev).
TRUST_PROXY_HOPS=
TRUST_PROXY_CIDRS=

# === Origins (CORS and WebSocket) ===
# Production/staging: exact origins, comma-separated, no wildcard, no trailing slash.
# If unset, the code falls back to the edrsr-ai-server.fun / www. / app. defaults.
# A set value REPLACES the defaults, so repeat every origin you need (the values below are for local dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
# Chrome extension IDs (the Web Store ID is dknfodmbknjengdbmdecidpapbiabgdb). Required in
# production: without it every chrome-extension:// origin gets 403.
CHROME_EXTENSION_IDS=
CHROME_EXTENSION_ID=

# WebSocket hardening
ENABLE_WS_AUTH_TIMEOUT=true
WS_AUTH_TIMEOUT_MS=10000
ENABLE_WS_CONN_RATE_LIMIT=true
WS_CONN_RATE_WINDOW_MS=60000
WS_CONN_RATE_LIMIT=60
WS_MAX_PAYLOAD_BYTES=16384

# Public base URL of the web portal (used to build share links)
APP_BASE_URL=https://app.example.com
# Optional override just for share links
PUBLIC_SHARE_BASE_URL=

# === Database and Supabase (REQUIRED) ===
# Plain PostgreSQL is enough; tables are created and migrated at startup.
DATABASE_URL="postgresql://edrsr_ai:PASSWORD@127.0.0.1:5432/edrsr_ai"
# Must be the same Supabase project the portal and the extension sign in against.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# Optional but needed for admin user lookup/delete and scripts/create-admin.js. Server-only, never in a client build.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# PostgreSQL connection tuning. SSL is also enabled automatically for *.supabase.com hosts.
# Local Postgres: leave SSL off. Hosted Postgres: PGSSL=true (or PGSSLMODE=require).
PGSSL=false
PGSSLMODE=disable
# Keep certificate verification enabled by default in production.
# Set false only for explicit local/provider exceptions after verifying TLS requirements.
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=10000
PG_MAX_USES=7500

# === Admin and auth ===
# Local development only: accept "dev:" bearer tokens (impersonation!). Ignored when
# NODE_ENV is production/staging. Never set on a public host.
DEV_AUTH_ENABLED=false
# Users that are always admins (comma-separated), in addition to the user_roles table
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_USER_IDS=
ADMIN_EMAIL_CACHE_MAX=1000
ADMIN_EMAIL_LOOKUP_MAX_PAGES=5
ADMIN_EMAIL_LOOKUP_PER_PAGE=200
# true: let the extension call /processed-urls and /urls/processed-check without auth
DISABLE_EXTENSION_PROCESSED_URL_FILTER=false

# === Queue and status updates ===
QUEUE_PUMP_INTERVAL_MS=5000
STATUS_UPDATE_INTERVAL_MS=1000
JOBS_MAX_LIMIT=500
# How long a job's cookie stays in memory (ms)
JOB_COOKIE_CACHE_TTL_MS=900000
# Name of this worker in queue locks; defaults to a generated id
WORKER_ID=

# === Batch processing ===
# Recommended: 10-25 for a 1 vCPU / 2 GB VPS, 5-10 for weak servers
DOWNLOAD_BATCH_SIZE=10
# Maximum cases per AI batch (split further by tokens)
AI_BATCH_SIZE=5
# Legacy fallback when DOWNLOAD_BATCH_SIZE / AI_BATCH_SIZE are unset
BATCH_SIZE=10
# Below this number of cases, process sequentially
BATCH_THRESHOLD=15
BATCH_DELAY=1000
# Parallel AI batches. Production runs 2; use 1 on a very small host or when the free quota is tight.
MAX_CONCURRENT_BATCHES=2

# === Memory ===
# Case text length cap in characters; 0 or empty = no truncation
MAX_CASE_TEXT_LENGTH=0
# Thresholds in MB (a job is failed when heapUsed exceeds them). Defaults are small;
# raise them in proportion to the Node heap (--max-old-space-size).
MEMORY_WARNING_MB=200
MAX_MEMORY_MB=400
CRITICAL_MEMORY_MB=420
MEMORY_LIMIT_MB=500
MEMORY_CHECK_INTERVAL=30000

# === Parsing ===
# Experimental: convert HTML to Markdown for the LLM (30-50% fewer tokens)
USE_MARKDOWN_EXTRACTION=false
ENABLE_TEXT_DEDUP=true
ENABLE_TEXT_STRUCTURING=false
ENABLE_TECHNICAL_STRIP=false
STRUCTURE_TEXT_MAX=12000
DEDUPE_MAX_LINE_LENGTH=2000
# TTL for cached temporary errors (network/timeout), ms; 0 = no TTL
TEMP_CACHE_TTL_MS=3600000
# HTML size limits (bytes) and scraper safety limits
READABILITY_MAX_HTML_BYTES=1500000
MAX_HTML_BYTES=3000000
MAX_SCRIPT_TAGS=200
MAX_HTML_LINE_LENGTH=200000
MAX_JS_KEYWORDS=3000
FULL_PAGE_TEXT_LIMIT=200000

# === Scraper (reyestr.court.gov.ua) ===
MAX_CONCURRENT_REQUESTS=2
REQUEST_DELAY_MS=1000
REQUEST_DELAY_JITTER_MS=250
REQUEST_DELAY_ON_RATE_LIMIT_MS=5000
ADAPTIVE_REQUEST_DELAY=true
CASE_TIMEOUT_MS=30000
FETCH_CASE_TIMEOUT_MS=30000
OVERALL_REQUEST_TIMEOUT_MS=60000
GOT_REQUEST_TIMEOUT_MS=45000
GOT_RETRY_LIMIT=2
GOT_RETRY_BACKOFF_MS=1500

# === API limits ===
MAX_LINKS_PER_REQUEST=300
MAX_URL_LENGTH=2048
MAX_PROMPT_LENGTH=4000
MAX_PROMPT_NAME_LENGTH=120
MAX_COOKIE_LENGTH=4096
MAX_CHAT_MESSAGE_LENGTH=4000
MAX_PROMPTS_IMPORT=200

# === Worker lifecycle and recovery ===
# Max job duration and max time without progress before a forced stop (ms)
MAX_JOB_DURATION_MS=1500000
MAX_STALL_DURATION_MS=1200000
ENABLE_WORKER_CLEANUP=true
WORKER_CLEANUP_INTERVAL_MS=300000
ENABLE_WORKER_AUTO_TERMINATE=true
WORKER_MAX_LIFETIME_MS=7200000
WORKER_HEALTHCHECK_INTERVAL_MS=600000
WORKER_HEALTHCHECK_AFTER_MS=1200000
ENABLE_PERIODIC_RECOVERY=true
RECOVERY_INTERVAL_MS=900000

# === Chat sessions (in memory) ===
CHAT_MAX_SESSIONS=5
CHAT_TTL_MS=900000
CHAT_CLEANUP_INTERVAL_MS=300000
ENABLE_CHAT_CLEANUP=true

# === Parsed-case cache ===
CACHE_MAX_PARSED_CASES=1000
CACHE_CLEANUP_INTERVAL_MS=900000
CACHE_TEMP_ERROR_TTL_MS=3600000
CACHE_STATEMENT_TIMEOUT_MS=60000
ENABLE_CACHE_CLEANUP=true

# === Prompt audit log ===
PROMPT_AUDIT_RETENTION_DAYS=90
PROMPT_AUDIT_CLEANUP_INTERVAL_MS=21600000

# === Health ===
# /api/health/light also requests HEALTH_LIGHT_UPSTREAM_URL and returns 503 if it is unreachable.
HEALTH_LIGHT_TTL_MS=15000
HEALTH_LIGHT_TIMEOUT_MS=5000
HEALTH_LIGHT_UPSTREAM_URL=https://reyestr.court.gov.ua/
HEALTH_FULL_TTL_MS=15000

# ============================================
# Build-time variables (NOT read by the server)
# ============================================
# Portal (web/), baked into the bundle by `npm --prefix web run build`; set them in the build
# shell, never put secrets here:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY   required in production builds
#   VITE_API_BASE=/api   VITE_WS_PATH=/ws       same-origin defaults
#   VITE_WS_URL, VITE_APP_NAME                  optional overrides
#   VITE_DEV_AUTH_ENABLED=false                 must not be "true" in production
#   Do not build with web/.env.local present (it targets a local Supabase and enables dev auth).
#
# Extension (scripts/build-extension.js); unset values fall back to extension/config.js:
#   EXTENSION_BUILD_ENV=production, PACKAGE_EXTENSION_ZIP=true
#   EXT_API_URL, EXT_WS_URL, EXT_SUPABASE_URL, EXT_SUPABASE_ANON_KEY, EXT_SUPABASE_REDIRECT_TO
#   EXT_DEV_API_URL, EXT_DEV_WS_URL, EXT_DEV_SUPABASE_URL, EXT_DEV_SUPABASE_ANON_KEY,
#   EXT_DEV_SUPABASE_REDIRECT_TO, EXT_DEV_AUTH_ENABLED
